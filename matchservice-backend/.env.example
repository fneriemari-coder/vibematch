# --- Database ---------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/matchservice?schema=public"

# --- App ----------------------------------------------------------------
PORT=3000
NODE_ENV=development
CORS_ORIGIN="http://localhost:5173,http://localhost:19006"
APP_URL="https://app.matchservice.dev" # Stripe Checkout success/cancel redirect base

# --- Observability (common/logging, common/observability, common/filters) --
# NODE_ENV=production switches app-logger.service.ts to JSON-lines stdout logs.
# Leave SENTRY_DSN unset to disable Sentry — errors are still logged to
# stdout either way; this only adds off-app error aggregation/alerting.
SENTRY_DSN=""
# GET /metrics (Prometheus text format, no auth — protect at the network
# layer) and GET /health (real DB round-trip) need no config.

# --- Auth -----------------------------------------------------------------
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d" # used only by chat.module.ts's WebSocket handshake JwtModule
ACCESS_TOKEN_EXPIRES_IN="15m" # AuthService-issued access tokens — short-lived; see refresh tokens below
# Refresh/verification/reset token TTLs are fixed in auth.service.ts
# (30d / 48h / 1h) rather than env-configurable — they're security
# parameters, not deployment config.

# --- Outbound email (auth.service.ts — verification + password reset) -------
# Leave SMTP_HOST unset for local/dev: EmailService logs the link instead of
# sending it, so verification/reset flows are still testable without a real
# mail provider. Set these to actually deliver email in staging/production.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="no-reply@matchservice.dev"

# --- Stripe (multi-currency subscriptions + platform take-rate) -------------
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"
STRIPE_PRICE_PREMIUM_CLIENT_USD="price_xxx"
STRIPE_PRICE_PREMIUM_CLIENT_BRL="price_xxx"
STRIPE_PRICE_PRO_PROVIDER_USD="price_xxx"
STRIPE_PRICE_PRO_PROVIDER_BRL="price_xxx"
PLATFORM_TAKE_RATE_MIN="0.03"
PLATFORM_TAKE_RATE_MAX="0.05"

# --- Fintech ----------------------------------------------------------------
RECEIVABLES_ADVANCE_DISCOUNT_RATE="0.05"
BNPL_RISK_FEE_RATE="0.05" # deducted from the provider's immediate BNPL payout

# --- Anti-fraud (anti-fraud.guard.ts) ----------------------------------------
FRAUD_ENCRYPTION_KEY="change-me-to-a-long-random-secret-min-16-chars" # AES-256-GCM key material (scrypt-derived)
SLACK_FRAUD_ALERT_WEBHOOK_URL="" # Slack incoming webhook — velocity-freeze alerts post here
ANTI_FRAUD_VELOCITY_WINDOW_MINUTES="10"
ANTI_FRAUD_VELOCITY_MAX_DISTINCT_PROVIDERS="3"
IDENTITY_VOLUME_THRESHOLD_USD="1000"
IDENTITY_VOLUME_THRESHOLD_BRL="5000"
IDENTITY_SCORE_DROP_THRESHOLD="150" # K-Score points
IDENTITY_SCORE_DROP_WINDOW_HOURS="48"
# Optional real GeoIP vendor lookup — {ip} is templated in. Leave unset to
# fall back to the CDN geo header (e.g. Cloudflare's CF-IPCountry) instead.
GEOIP_LOOKUP_URL_TEMPLATE=""

# --- Stripe Connect (real payouts — connect.service.ts) ----------------------
# No separate key needed beyond STRIPE_SECRET_KEY above; Connect uses the
# same platform API key with the `transfers` capability requested per account.

# --- Admin dashboard (admin-analytics.service.ts) ----------------------------
SUBSCRIPTION_PRICE_USD="49"
SUBSCRIPTION_PRICE_BRL="149"
# Platform share of every escrow release — REAL money kept, no longer a
# projection. EscrowService.complete() credits the provider
# `budget * (1 - rate)` as a WalletTransaction of type ESCROW_RELEASE and the
# platform keeps the remainder. The provider's share is what gets rounded to
# the cent and the platform absorbs the remainder, so the two always sum to
# the budget exactly. AdminAnalyticsService reads the same key to report it.
# Must be >= 0 and < 1; anything else falls back to the 0.03 default.
PLATFORM_ESCROW_TAKE_RATE="0.03"

# --- AI Infrastructure Watcher (ai-watcher.service.ts) -----------------------
# Fraction of ACTIVE maintenance agreements "failing" per hourly sweep — this
# is a SIMULATION (no real hosted-app fleet is wired up), see the service's
# doc comment for what a production version would read instead.
AI_WATCHER_SIMULATED_FAILURE_RATE="0.05"

# --- Translation (chat) -------------------------------------------------
OPENAI_API_KEY="sk-xxx"
TRANSLATION_PROVIDER="openai" # "openai" | "deepl" | "none"
DEEPL_API_KEY=""

# --- AI Intent Translator (Discovery Feed) -----------------------------
OPENAI_INTENT_MODEL="gpt-4o-mini"

# --- Course cover art (training catalogue) ------------------------------
# Needs OPENAI_API_KEY *and* the AWS_* block below: the image is generated by
# one and stored by the other, and a cover with nowhere to live is wasted
# spend. Without both, courses fall back to the cover the app draws from the
# title — on-brand and never broken, just not photography.
OPENAI_IMAGE_MODEL="gpt-image-1"

# --- Operator account ----------------------------------------------------
# Every /admin route is behind Role.ADMIN and no other seed creates one, so
# without this the operator surfaces answer 403 to every account that exists —
# including yours. Read only by `npm run seed:admin`, never by the API, so set
# them for the one-off run rather than storing them on the service:
#
#   ADMIN_EMAIL=voce@dominio.com ADMIN_PASSWORD='…' npm run seed:admin
#
# Re-running rotates the password; an existing account is promoted in place,
# keeping its profile and history.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""   # minimum 12 characters

# --- Narrated lesson videos ---------------------------------------------
# Reads each module's voiceScript aloud and muxes it over the course cover
# with ffmpeg. Needs OPENAI_API_KEY, the AWS_* block, and ffmpeg on PATH (the
# Dockerfile installs it). Rendered on demand via POST /admin/courses/videos —
# never on boot, since a batch takes minutes of CPU.
OPENAI_TTS_MODEL="gpt-4o-mini-tts"
OPENAI_TTS_VOICE="onyx"

# --- Trend monitor / push notifications (Firebase Admin SDK) ----------------
# Paste the full service-account JSON as a single-line string (this is the
# "Firebase credentials" referenced by push-notification.service.ts).
FIREBASE_SERVICE_ACCOUNT_JSON=""
TREND_VIRALITY_THRESHOLD="500"
TREND_SCAN_WINDOW_HOURS="24"

# --- Redis (BullMQ-ready queueing / WebSocket chat scaling) ------------------
# Not yet consumed by application code (chat/trend-monitor currently run
# in-process via @nestjs/schedule) — provisioned now so a queue-backed worker
# or a Socket.io Redis adapter can be added later without new infra.
REDIS_URL="redis://localhost:6379"

# --- AWS S3 (Discovery Feed video/image storage + fast delivery) ------------
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET="matchservice-media"
AWS_REGION="us-east-1"

# --- Simulated population / behavioural bots (admin-only, see /admin/simulation) ---
# OFF unless this is EXACTLY the string "true". When on, accounts on the
# reserved @simulado.vibematch.dev domain answer swipes, reply in chat and
# publish feed posts on a 10-minute cron. Leave it unset in any environment
# with real users: a deployment that starts inventing messages on its own is
# far worse than having no bots at all. The manual routes under
# /admin/simulation work regardless of this flag.
SIMULATION_BOTS_ENABLED=""
