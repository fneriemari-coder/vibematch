// MatchService — Prisma schema
// PostgreSQL + PostGIS (geo radius search is done via raw SQL in users.service.ts,
// using the lat/lng columns below with ST_DWithin — see modules/users/users.service.ts)

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  CLIENT
  PROVIDER
  BOTH
  ADMIN
}

// Single-purpose opaque tokens issued by AuthService — refresh sessions,
// email verification links, password-reset links. Sharing one table keeps
// the "random token, hashed at rest, single-use or revocable, expires" shape
// in one place instead of three near-identical tables.
enum AuthTokenPurpose {
  REFRESH
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum PlatformMode {
  CLOUD
  LOCAL
}

enum SwipeMode {
  CLOUD
  LOCAL
  B2B
}

enum SwipeDirection {
  LIKE
  DISLIKE
}

enum MatchType {
  SERVICE
  B2B
}

enum MatchStatus {
  ACTIVE
  ARCHIVED
}

enum Currency {
  USD
  BRL
}

enum EscrowStatus {
  PENDING
  FUNDED
  COMPLETED
  DISPUTED
  REFUNDED
  CANCELED
}

enum SubscriptionTier {
  FREE
  PREMIUM_CLIENT
  PRO_PROVIDER
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}

enum KanbanStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum WalletTransactionType {
  ADVANCE
  ESCROW_RELEASE
  PLATFORM_FEE
  DEPOSIT
  WITHDRAWAL
  BNPL_FUNDING // immediate provider payout when a project is BNPL-financed — see bnpl.service.ts
  MILESTONE_RELEASE // AI-verified milestone payout — see ai-validator.service.ts
  MAINTENANCE_REVENUE // provider's 85% share of a recurring maintenance invoice — see maintenance.service.ts
  COURSE_REVENUE // instructor's 80% share of a course purchase — see academy.service.ts
  MASTERMIND_REVENUE // host's 80% share of a mastermind booking — see mastermind.service.ts
}

enum PaymentModel {
  UPFRONT
  BNPL_FINANCED
}

enum MilestoneStatus {
  PENDING
  VERIFYING
  APPROVED
}

enum InstallmentStatus {
  SCHEDULED
  CHARGED
  FAILED
}

enum AccountStatus {
  ACTIVE
  UNDER_REVIEW
  SUSPENDED
}

enum FraudVerdict {
  ALLOWED
  BLOCKED
}

enum MaintenanceStatus {
  ACTIVE
  PAUSED
}

enum TicketSeverity {
  LOW
  HIGH
}

enum TicketStatus {
  OPEN
  RESOLVED
}

enum FeedMode {
  CLOUD
  LOCAL
}

enum PostStatus {
  PUBLISHED
  BLOCKED
}

/// Lifecycle of an editorial Article. Only PUBLISHED rows are ever served by
/// GET /content/articles — see modules/content/content.service.ts.
enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Editorial verticals of the "Conteúdo" hub. An enum rather than a free-text
/// tag so the client can render a fixed, finite filter bar.
enum ArticleCategory {
  GESTAO
  VENDAS
  LIDERANCA
  ESTRATEGIA
  MARKETING
  FINANCAS
  TECNOLOGIA
  CARREIRA
}

/// Commercial tiers of a paid peer group ("Círculo"). CIRCULO is the entry
/// peer group, SCALE adds a dedicated mentor host + deal room, CONSELHO is a
/// quarterly advisory board for the member's own company.
enum CommunityTier {
  CIRCULO
  SCALE
  CONSELHO
}

/// A seat's lifecycle. PENDING is written by POST /communities/:id/apply and
/// only ever flips to ACTIVE from a real Stripe event (see
/// stripe-webhook.service.ts). ROTATED_OUT is the reciprocity outcome — a
/// member who only consumes and never answers loses the seat.
enum MembershipStatus {
  PENDING
  ACTIVE
  PAUSED
  ROTATED_OUT
}

/// Verticals of the external news feed ("Radar"). A fixed enum rather than a
/// free-text tag so the client can render a stable filter bar, and so a
/// mis-tagged source can never invent a category — the category is a property
/// of the NewsSource we curated, not of anything the publisher sends us.
enum NewsCategory {
  ENGENHARIA
  MARKETING
  FINANCAS
  PUBLICIDADE
  TECNOLOGIA
  GESTAO
  EMPREENDEDORISMO
}

/// What a syndicated item actually *is*, which is what decides how the client
/// renders the card: ARTICLE = headline + excerpt + photo, VIDEO = inline
/// player (YouTube channel feeds), PAPER = academic/research abstract.
enum NewsMediaKind {
  ARTICLE
  VIDEO
  PAPER
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model User {
  id            String       @id @default(uuid())
  email         String       @unique
  passwordHash  String       @map("password_hash")
  role          Role         @default(CLIENT)
  currentMode   PlatformMode @default(CLOUD) @map("current_mode")
  country       String // ISO-3166 alpha-2, e.g. "US", "BR" — drives currency/locale defaults
  walletBalance Decimal      @default(0) @map("wallet_balance") @db.Decimal(14, 2)
  fcmToken      String?      @map("fcm_token") // Firebase Cloud Messaging device token, refreshed on app boot
  isBot         Boolean      @default(false) @map("is_bot") // system/robot profile used by ai-publisher.service.ts

  // --- Auth security (see modules/auth/*) ---
  emailVerified   Boolean   @default(false) @map("email_verified")
  emailVerifiedAt DateTime? @map("email_verified_at")

  // --- LGPD/GDPR (see modules/users/data-privacy.service.ts) ---
  // Set by the "right to erasure" flow. We anonymize rather than hard-delete
  // (financial/contract records — WalletTransaction, EscrowProject,
  // MaintenanceAgreement — must survive for accounting/dispute/tax
  // retention obligations); this flag is what actually blocks the account
  // from being usable again, independent of the scrambled email/password.
  deletedAt DateTime? @map("deleted_at")

  // --- Anti-fraud / KYC (see fintech/guards/anti-fraud.guard.ts) ---
  accountStatus           AccountStatus @default(ACTIVE) @map("account_status")
  identityVerified        Boolean       @default(false) @map("identity_verified") // Stripe Identity — see fintech/identity.service.ts
  stripeIdentitySessionId String?       @map("stripe_identity_session_id")

  // --- Real payouts (see fintech/connect.service.ts) ---
  // wallet_balance above stays the in-app ledger/spendable-credit number
  // regardless of Connect status; these two fields gate whether earnings
  // ALSO get pushed as real Stripe Transfers to money the provider can
  // actually withdraw to a bank account.
  stripeConnectAccountId      String? @map("stripe_connect_account_id")
  stripeConnectPayoutsEnabled Boolean @default(false) @map("stripe_connect_payouts_enabled")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  profile      UserProfile?
  score        ProviderScore?
  subscription Subscription?

  swipesMade     Swipe[] @relation("SwipesMade")
  swipesReceived Swipe[] @relation("SwipesReceived")

  matchesAsOne Match[] @relation("MatchUserOne")
  matchesAsTwo Match[] @relation("MatchUserTwo")

  escrowAsClient   EscrowProject[] @relation("EscrowClient")
  escrowAsProvider EscrowProject[] @relation("EscrowProvider")

  chatMessages       ChatMessage[]
  walletTransactions WalletTransaction[]
  kanbanAssignments  KanbanTask[]

  discoveryPosts       DiscoveryPost[]
  aiProjectSuggestions AIProjectSuggestion[]
  fraudCheckLogs       FraudCheckLog[]

  maintenanceAsClient   MaintenanceAgreement[] @relation("MaintenanceClient")
  maintenanceAsProvider MaintenanceAgreement[] @relation("MaintenanceProvider")

  coursesInstructed        BusinessCourse[]        @relation("CourseInstructor")
  courseEnrollments        CourseEnrollment[]
  mastermindSessionsHosted LiveMastermindSession[] @relation("MastermindHost")
  mastermindBookings       MastermindBooking[]     @relation("MastermindBookings")

  quizAttempts QuizAttempt[]
  certificates IssuedCertificate[]

  articles Article[] @relation("ArticleAuthor")

  communitiesHosted    Community[]           @relation("CommunityHost")
  communityMemberships CommunityMembership[]

  savedNewsItems SavedNewsItem[]

  authTokens AuthToken[]

  @@map("users")
}

model UserProfile {
  id     String @id @default(uuid())
  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name          String
  bio           String   @default("")
  skills        String[] @default([])
  portfolioUrls String[] @default([]) @map("portfolio_urls")

  // Stored as plain floats; PostGIS ST_MakePoint(lng, lat) is computed on the fly
  // in raw-SQL radius queries (see UsersService.findNearby). This avoids having to
  // keep a generated geography column in sync via triggers for an MVP.
  latitude  Float? @map("latitude")
  longitude Float? @map("longitude")

  averageRating Float    @default(0) @map("average_rating")
  b2bNetworking Boolean  @default(false) @map("b2b_networking")
  hourlyRate    Decimal? @map("hourly_rate") @db.Decimal(10, 2)
  rateCurrency  Currency @default(USD) @map("rate_currency")

  // --- Mentors directory (GET /academy/mentors) ---
  // Curated, admin-granted group — a user cannot flip `isMentor` on
  // themselves; only PATCH /admin/users/:userId/mentor sets it.
  isMentor       Boolean  @default(false) @map("is_mentor")
  mentorHeadline String?  @map("mentor_headline")
  mentorTopics   String[] @default([]) @map("mentor_topics")

  createdAt DateTime @updatedAt @map("updated_at")

  @@index([latitude, longitude])
  @@map("user_profiles")
}

model Swipe {
  id        String         @id @default(uuid())
  swiperId  String         @map("swiper_id")
  swiper    User           @relation("SwipesMade", fields: [swiperId], references: [id], onDelete: Cascade)
  swipedId  String         @map("swiped_id")
  swiped    User           @relation("SwipesReceived", fields: [swipedId], references: [id], onDelete: Cascade)
  direction SwipeDirection
  mode      SwipeMode
  createdAt DateTime       @default(now()) @map("created_at")

  // A user may only swipe another user once per mode — re-swiping is a no-op at the API level.
  @@unique([swiperId, swipedId, mode])
  @@index([swipedId, mode, direction])
  @@map("swipes")
}

model Match {
  id        String      @id @default(uuid())
  userOneId String      @map("user_one_id")
  userOne   User        @relation("MatchUserOne", fields: [userOneId], references: [id], onDelete: Cascade)
  userTwoId String      @map("user_two_id")
  userTwo   User        @relation("MatchUserTwo", fields: [userTwoId], references: [id], onDelete: Cascade)
  type      MatchType
  status    MatchStatus @default(ACTIVE)
  createdAt DateTime    @default(now()) @map("created_at")

  escrowProject EscrowProject?
  chatMessages  ChatMessage[]

  @@unique([userOneId, userTwoId, type])
  @@index([userTwoId])
  @@map("matches")
}

model EscrowProject {
  id         String @id @default(uuid())
  matchId    String @unique @map("match_id")
  match      Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  clientId   String @map("client_id")
  client     User   @relation("EscrowClient", fields: [clientId], references: [id])
  providerId String @map("provider_id")
  provider   User   @relation("EscrowProvider", fields: [providerId], references: [id])

  budget   Decimal      @db.Decimal(14, 2)
  currency Currency
  status   EscrowStatus @default(PENDING)

  // true once the provider has used /wallet/advance to cash out early on this project
  advanced Boolean @default(false)

  // Captured when the funding Checkout Session completes. Without it a refund
  // has to search Stripe by metadata, which is slow and not reliably unique.
  stripePaymentIntentId String? @map("stripe_payment_intent_id")

  // BNPL_FINANCED: provider is paid upfront (minus risk fee) via bnpl.service.ts,
  // client repays over `installmentCount` scheduled charges (see BnplInstallment).
  paymentModel     PaymentModel @default(UPFRONT) @map("payment_model")
  installmentCount Int?         @map("installment_count")

  createdAt   DateTime  @default(now()) @map("created_at")
  fundedAt    DateTime? @map("funded_at")
  completedAt DateTime? @map("completed_at")
  disputedAt  DateTime? @map("disputed_at")

  kanbanTasks          KanbanTask[]
  walletTransactions   WalletTransaction[]
  milestones           ProjectMilestone[]
  bnplInstallments     BnplInstallment[]
  maintenanceAgreement MaintenanceAgreement?

  // AntiFraudGuard.checkVelocity and ScoreEngine both filter on these on
  // every financial request; without indexes each one was a sequential scan.
  @@index([clientId])
  @@index([providerId])
  @@index([status])
  @@map("escrow_projects")
}

model ProviderScore {
  id         String @id @default(uuid())
  providerId String @unique @map("provider_id")
  provider   User   @relation(fields: [providerId], references: [id], onDelete: Cascade)

  reliabilityRate      Float @default(1) @map("reliability_rate") // 0..1 (1 - cancellation rate)
  responseTimeMinutes  Float @default(0) @map("response_time_minutes")
  completedJobsCount   Int   @default(0) @map("completed_jobs_count")
  financialHealthScore Int   @default(500) @map("financial_health_score") // 0..1000

  // Snapshot of the score just before the current one, so anti-fraud.guard.ts
  // can detect a "drastic drop in under 48h" without a full history table.
  previousFinancialHealthScore Int?      @map("previous_financial_health_score")
  previousScoreAt              DateTime? @map("previous_score_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("provider_scores")
}

model Subscription {
  id                   String             @id @default(uuid())
  userId               String             @unique @map("user_id")
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier                 SubscriptionTier   @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  currency             Currency           @default(USD)
  stripeCustomerId     String?            @map("stripe_customer_id")
  stripeSubscriptionId String?            @map("stripe_subscription_id")
  expiresAt            DateTime?          @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Looked up by customer id on every invoice.paid webhook.
  @@index([stripeCustomerId])
  @@map("subscriptions")
}

model ChatMessage {
  id                String   @id @default(uuid())
  matchId           String   @map("match_id")
  match             Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  senderId          String   @map("sender_id")
  sender            User     @relation(fields: [senderId], references: [id])
  content           String
  translatedContent String?  @map("translated_content")
  sourceLang        String?  @map("source_lang")
  targetLang        String?  @map("target_lang")
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([matchId, createdAt])
  @@map("chat_messages")
}

model KanbanTask {
  id              String        @id @default(uuid())
  escrowProjectId String        @map("escrow_project_id")
  escrowProject   EscrowProject @relation(fields: [escrowProjectId], references: [id], onDelete: Cascade)
  title           String
  description     String        @default("")
  status          KanbanStatus  @default(TODO)
  assigneeId      String?       @map("assignee_id")
  assignee        User?         @relation(fields: [assigneeId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([escrowProjectId, status])
  @@map("kanban_tasks")
}

// Append-only ledger backing `User.walletBalance` — every balance mutation must
// write a row here so the balance is always reconstructable/auditable.
model WalletTransaction {
  id              String                @id @default(uuid())
  userId          String                @map("user_id")
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            WalletTransactionType
  amount          Decimal               @db.Decimal(14, 2) // positive = credit, negative = debit
  currency        Currency
  relatedEscrowId String?               @map("related_escrow_id")
  relatedEscrow   EscrowProject?        @relation(fields: [relatedEscrowId], references: [id])
  metadata        Json?
  createdAt       DateTime              @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("wallet_transactions")
}

// ---------------------------------------------------------------------------
// Discovery Feed + AI Intent Translator
// ---------------------------------------------------------------------------

model DiscoveryPost {
  id                   String     @id @default(uuid())
  userId               String     @map("user_id")
  user                 User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title                String
  contentText          String     @map("content_text")
  mediaUrl             String?    @map("media_url")
  videoDurationSeconds Int?       @map("video_duration_seconds")
  likesCount           Int        @default(0) @map("likes_count")
  viewsCount           Int        @default(0) @map("views_count")
  // Gate set by ai-moderator.service.ts before a user-submitted post is ever
  // served in the public feed. AI-publisher-generated posts are created
  // PUBLISHED directly (system-authored, not subject to the user-post gate).
  status               PostStatus @default(PUBLISHED)
  moderationReason     String?    @map("moderation_reason")
  // Set once the trend monitor has fired a viral push alert for this post,
  // so the 30-minute cron never double-notifies the same post.
  trendNotifiedAt      DateTime?  @map("trend_notified_at")
  createdAt            DateTime   @default(now()) @map("created_at")

  tags PostTag[]

  @@index([createdAt])
  @@map("discovery_posts")
}

model PostTag {
  id      String        @id @default(uuid())
  postId  String        @map("post_id")
  post    DiscoveryPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tagName String        @map("tag_name") // e.g. 'AI_AUTOMATION', 'VIDEO_EDITING', 'LOCAL_MARKETING'

  @@index([tagName])
  @@index([postId])
  @@map("post_tags")
}

model AIProjectSuggestion {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rawInput         String   @map("raw_input")
  interpretedNeeds String[] @map("interpreted_needs") // exactly 3 market-standard skill tags
  suggestedMode    FeedMode @default(CLOUD) @map("suggested_mode")
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("ai_project_suggestions")
}

// ---------------------------------------------------------------------------
// BNPL Corporativo + AI Delivery Validator
// ---------------------------------------------------------------------------

model ProjectMilestone {
  id                  String          @id @default(uuid())
  projectId           String          @map("project_id")
  project             EscrowProject   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title               String
  criteriaDescription String          @map("criteria_description")
  status              MilestoneStatus @default(PENDING)
  // Portion of EscrowProject.budget released to the provider when this
  // milestone is AI-approved. Null = split the remaining budget evenly
  // across the project's milestones at release time (see ai-validator.service.ts).
  releaseAmount       Decimal?        @map("release_amount") @db.Decimal(14, 2)
  // Append-only audit trail of every AI verification attempt (timestamp,
  // compliance score, feedback) — never overwritten, only appended to.
  aiFeedbackLog       String          @default("") @map("ai_feedback_log") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([projectId, status])
  @@map("project_milestones")
}

model BnplInstallment {
  id                String            @id @default(uuid())
  escrowProjectId   String            @map("escrow_project_id")
  escrowProject     EscrowProject     @relation(fields: [escrowProjectId], references: [id], onDelete: Cascade)
  installmentNumber Int               @map("installment_number")
  amount            Decimal           @db.Decimal(14, 2)
  currency          Currency
  dueDate           DateTime          @map("due_date")
  status            InstallmentStatus @default(SCHEDULED)
  stripeInvoiceId   String?           @map("stripe_invoice_id")
  chargedAt         DateTime?         @map("charged_at")
  failureReason     String?           @map("failure_reason")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([escrowProjectId, installmentNumber])
  @@index([status, dueDate])
  // Looked up by invoice id on every invoice webhook.
  @@index([stripeInvoiceId])
  @@map("bnpl_installments")
}

// ---------------------------------------------------------------------------
// Anti-fraud audit trail
// ---------------------------------------------------------------------------

// One row per AntiFraudGuard evaluation on a financial route. The raw device
// fingerprint (IP, device ID, GPS/behavior hints) is AES-256-GCM encrypted
// before it ever reaches this table — see common/security/aes-encryption.util.ts
// — so a DB leak doesn't leak raw PII, only ciphertext plus the verdict/reason
// needed for audit review.
model FraudCheckLog {
  id               String       @id @default(uuid())
  userId           String       @map("user_id")
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  route            String
  verdict          FraudVerdict
  reasonCode       String?      @map("reason_code")
  encryptedPayload String?      @map("encrypted_payload") @db.Text
  createdAt        DateTime     @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("fraud_check_logs")
}

// ---------------------------------------------------------------------------
// Continuous Maintenance Contracts (recurring support/hosting revenue)
// ---------------------------------------------------------------------------

model MaintenanceAgreement {
  id         String        @id @default(uuid())
  projectId  String        @unique @map("project_id") // one maintenance agreement per completed project
  project    EscrowProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  clientId   String        @map("client_id")
  client     User          @relation("MaintenanceClient", fields: [clientId], references: [id])
  providerId String        @map("provider_id")
  provider   User          @relation("MaintenanceProvider", fields: [providerId], references: [id])

  monthlyFee            Decimal           @map("monthly_fee") @db.Decimal(10, 2)
  currency              Currency
  hostingIncluded       Boolean           @default(true) @map("hosting_included")
  supportHoursAllocated Int               @map("support_hours_allocated")
  status                MaintenanceStatus @default(ACTIVE)

  // Optional live URL for the hosted app this agreement covers. When set,
  // ai-watcher.service.ts does a REAL HTTP health check instead of
  // simulating one — see that file's doc comment.
  hostingUrl String? @map("hosting_url")

  // Platform keeps this share of every recurring invoice; the rest is
  // credited to the provider's wallet_balance — see maintenance.service.ts.
  platformTakeRate Float @default(0.15) @map("platform_take_rate")

  stripeCustomerId     String? @map("stripe_customer_id")
  stripeSubscriptionId String? @map("stripe_subscription_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tickets AITicketMonitor[]

  @@index([status])
  // Looked up by subscription id on every invoice webhook.
  @@index([stripeSubscriptionId])
  @@map("maintenance_agreements")
}

model AITicketMonitor {
  id            String               @id @default(uuid())
  agreementId   String               @map("agreement_id")
  agreement     MaintenanceAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  errorLog      String               @map("error_log") @db.Text
  severityLevel TicketSeverity       @map("severity_level")
  status        TicketStatus         @default(OPEN)

  // Skill tags this failure touches — sourced from the provider's own
  // UserProfile.skills at ticket-creation time (no dedicated per-project tag
  // exists in the schema, so this is the closest honest signal available).
  // Drives ai-retention-push.service.ts's course<->error correlation.
  relatedTags String[] @default([]) @map("related_tags")

  detectedAt DateTime  @default(now()) @map("detected_at")
  resolvedAt DateTime? @map("resolved_at")

  @@index([agreementId, status])
  @@map("ai_ticket_monitors")
}

// ---------------------------------------------------------------------------
// VibeAcademy — Executive Education
// ---------------------------------------------------------------------------

model BusinessCourse {
  id              String   @id @default(uuid())
  instructorId    String   @map("instructor_id")
  instructor      User     @relation("CourseInstructor", fields: [instructorId], references: [id])
  title           String
  description     String
  price           Decimal  @db.Decimal(10, 2)
  currency        Currency
  rating          Float    @default(0)
  mediaPreviewUrl String?  @map("media_preview_url")

  // Market-standard skill tags this course teaches, e.g. a Finance course ->
  // ['CONTROLLER', 'FINANCIAL_AUDIT']. Drives GET /academy/course-connections/:courseId,
  // which matches these against UserProfile.skills / PostTag.tagName.
  skillsTaught String[] @default([]) @map("skills_taught")

  // pdfkit-generated executive summary + implementation checklist + swipe-deck
  // link, uploaded to S3 by ai-factory.service.ts / certificate.service.ts.
  materialDownloadUrl String? @map("material_download_url")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  enrollments  CourseEnrollment[]
  modules      CourseModule[]
  quiz         CourseQuiz?
  certificates IssuedCertificate[]

  @@index([instructorId])
  @@map("business_courses")
}

model CourseModule {
  id          String         @id @default(uuid())
  courseId    String         @map("course_id")
  course      BusinessCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  orderIndex  Int            @map("order_index")
  title       String
  // Full ~5-minute voice script generated by AiCourseFactoryService.
  voiceScript String         @map("voice_script") @db.Text
  // Set once generateLessonVideo() (currently a placeholder — see
  // ai-factory.service.ts) "renders" this lesson.
  videoUrl    String?        @map("video_url")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([courseId, orderIndex])
  @@map("course_modules")
}

model CourseEnrollment {
  id          String         @id @default(uuid())
  userId      String         @map("user_id")
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId    String         @map("course_id")
  course      BusinessCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  pricePaid   Decimal        @map("price_paid") @db.Decimal(10, 2) // post-discount amount actually charged — audit trail
  currency    Currency
  purchasedAt DateTime       @default(now()) @map("purchased_at")

  // A user buys (and gets access to) a given course exactly once.
  @@unique([userId, courseId])
  @@map("course_enrollments")
}

model LiveMastermindSession {
  id            String   @id @default(uuid())
  hostId        String   @map("host_id")
  host          User     @relation("MastermindHost", fields: [hostId], references: [id])
  title         String
  accessFee     Decimal  @map("access_fee") @db.Decimal(10, 2)
  currency      Currency
  scheduledFor  DateTime @map("scheduled_for")
  // Real host-supplied URL (Zoom/YouTube Live/etc.) — null until the host
  // sets one; mastermind.service.ts never fabricates a placeholder here.
  liveStreamUrl String?  @map("live_stream_url")

  createdAt DateTime @default(now()) @map("created_at")

  bookings MastermindBooking[]

  @@index([scheduledFor])
  @@map("live_mastermind_sessions")
}

/// A client's paid seat in a LiveMastermindSession — see mastermind.service.ts.
model MastermindBooking {
  id        String                @id @default(uuid())
  sessionId String                @map("session_id")
  session   LiveMastermindSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId    String                @map("user_id")
  user      User                  @relation("MastermindBookings", fields: [userId], references: [id], onDelete: Cascade)
  pricePaid Decimal               @map("price_paid") @db.Decimal(10, 2)
  currency  Currency
  createdAt DateTime              @default(now()) @map("created_at")

  @@unique([sessionId, userId])
  @@map("mastermind_bookings")
}

// ---------------------------------------------------------------------------
// AiQuizAndCertificateService — academic validation
// ---------------------------------------------------------------------------

model CourseQuiz {
  id            String         @id @default(uuid())
  courseId      String         @unique @map("course_id")
  course        BusinessCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  // Array of { question, options: string[], correctAnswerIndex }, generated
  // by quiz-generator.service.ts.
  questionsJson Json           @map("questions_json")

  createdAt DateTime @default(now()) @map("created_at")

  attempts QuizAttempt[]

  @@map("course_quizzes")
}

model QuizAttempt {
  id              String     @id @default(uuid())
  userId          String     @map("user_id")
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  quizId          String     @map("quiz_id")
  quiz            CourseQuiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  scorePercentage Float      @map("score_percentage")
  passed          Boolean

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, quizId])
  @@map("quiz_attempts")
}

model IssuedCertificate {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId        String         @map("course_id")
  // Was a bare String with no relation, so deleting a course silently
  // orphaned every certificate that referenced it. Restrict, not Cascade —
  // a credential record must outlive the catalogue entry that produced it.
  course          BusinessCourse @relation(fields: [courseId], references: [id], onDelete: Restrict)
  certificateUuid String         @unique @map("certificate_uuid")
  downloadUrl     String         @map("download_url")
  issuedAt        DateTime       @default(now()) @map("issued_at")

  // One certificate per user per course. Without this a learner could pass
  // the same quiz repeatedly, and each pass awarded +50 K-Score — which
  // gates paid community seats.
  @@unique([userId, courseId])
  @@map("issued_certificates")
}

// ---------------------------------------------------------------------------
// Conteúdo — editorial hub (blog)
// ---------------------------------------------------------------------------

/// A long-form editorial piece rendered by the "Conteúdo" tab. `body` is
/// markdown; the client renders it. Written either by a user
/// (POST /content/articles) or by ArticleGeneratorService
/// (POST /content/generate-article), which is what `aiGenerated` records.
model Article {
  id       String @id @default(uuid())
  authorId String @map("author_id")
  author   User   @relation("ArticleAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  // Derived from `title` server-side (accent-stripped, hyphenated, numeric
  // suffix on collision) — never accepted from the client, so it stays a
  // stable, guessable public URL segment.
  slug          String  @unique
  title         String
  excerpt       String
  body          String  @db.Text
  coverImageUrl String? @map("cover_image_url")

  category    ArticleCategory
  // Estimated reading time, computed from the body's word count at 200 wpm
  // (minimum 1) — never client-supplied.
  readMinutes Int             @map("read_minutes")

  status      ArticleStatus @default(DRAFT)
  viewCount   Int           @default(0) @map("view_count")
  aiGenerated Boolean       @default(false) @map("ai_generated")
  publishedAt DateTime?     @map("published_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status, publishedAt])
  @@index([category])
  @@map("articles")
}

// ---------------------------------------------------------------------------
// Comunidades ("Círculos") — paid peer groups
// ---------------------------------------------------------------------------

/// A small, curated paid peer group. Unlike a plain community product, a
/// Círculo sits on top of the marketplace: members can hire each other under
/// the platform's existing escrow, so `seatLimit` and `minKScore` are real
/// gates rather than marketing copy.
model Community {
  id          String        @id @default(uuid())
  tier        CommunityTier
  name        String
  tagline     String
  description String

  monthlyFee Decimal  @map("monthly_fee") @db.Decimal(10, 2)
  currency   Currency
  seatLimit  Int      @map("seat_limit")
  cadence    String // e.g. "Encontro mensal ao vivo (Mesa Redonda)"

  // K-Score floor (ProviderScore.financialHealthScore, 0-1000) a user must
  // clear to take a seat — the tier is earned, not only purchased.
  minKScore Int @default(0) @map("min_k_score")

  focusTopics String[] @default([]) @map("focus_topics")

  hostId String @map("host_id")
  host   User   @relation("CommunityHost", fields: [hostId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships CommunityMembership[]

  @@index([tier])
  @@map("communities")
}

/// One member's seat. `askedCount`/`answeredCount` are the reciprocity
/// ledger — a seat is kept by both asking and answering, and
/// `contributionScore` is what a rotation review reads before flipping a
/// membership to ROTATED_OUT.
model CommunityMembership {
  id          String    @id @default(uuid())
  communityId String    @map("community_id")
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  status MembershipStatus @default(PENDING)

  askedCount        Int @default(0) @map("asked_count")
  answeredCount     Int @default(0) @map("answered_count")
  contributionScore Int @default(0) @map("contribution_score")

  // Set from the checkout.session.completed webhook, never from the apply route.
  stripeSubscriptionId String? @map("stripe_subscription_id")

  joinedAt DateTime @default(now()) @map("joined_at")

  @@unique([communityId, userId])
  @@index([userId, status])
  @@map("community_memberships")
}

/// Refresh sessions, email-verification links and password-reset links —
/// see the AuthTokenPurpose doc comment above. The plaintext token is only
/// ever returned to the caller/emailed once; `tokenHash` (sha256) is what's
/// persisted, so a DB leak alone can't be replayed as a live session or link.
model AuthToken {
  id         String           @id @default(uuid())
  userId     String           @map("user_id")
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose    AuthTokenPurpose
  tokenHash  String           @unique @map("token_hash")
  expiresAt  DateTime         @map("expires_at")
  // Set once the token is used (verify/reset) or revoked/rotated (refresh) —
  // whatever the reason, a non-null consumedAt means "no longer valid."
  consumedAt DateTime?        @map("consumed_at")
  createdAt  DateTime         @default(now()) @map("created_at")

  @@index([userId, purpose])
  @@map("auth_tokens")
}

// ---------------------------------------------------------------------------
// Radar — external news/video/paper feed (see modules/feed/news-ingestion.service.ts)
// ---------------------------------------------------------------------------

/// One curated RSS/Atom endpoint we syndicate from. `category` and
/// `mediaKind` live here rather than on the item because they are an
/// editorial decision about the *source* — a publisher's own tags are
/// inconsistent and untrusted. `lastFetchedAt`/`lastError` are the operator's
/// only window into a third-party host that has quietly started failing.
model NewsSource {
  id        String        @id @default(uuid())
  name      String
  feedUrl   String        @unique @map("feed_url")
  siteUrl   String        @map("site_url")
  category  NewsCategory
  mediaKind NewsMediaKind @default(ARTICLE) @map("media_kind")
  language  String        @default("pt")
  active    Boolean       @default(true)

  lastFetchedAt DateTime? @map("last_fetched_at")
  lastError     String?   @map("last_error")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items NewsItem[]

  @@index([active, category])
  @@map("news_sources")
}

/// A single syndicated entry. We store only what a feed reader is entitled to
/// keep — headline, the publisher's own excerpt, a thumbnail and a link back
/// to the original — never the full article body. See the header comment on
/// news-ingestion.service.ts for why that line is where it is.
///
/// `externalId` is the feed's own guid (or the link when a feed omits one);
/// the [sourceId, externalId] unique is what makes re-running ingestion an
/// upsert instead of a duplicate storm.
model NewsItem {
  id       String     @id @default(uuid())
  sourceId String     @map("source_id")
  source   NewsSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  externalId String  @map("external_id")
  title      String
  summary    String  @db.Text
  url        String
  imageUrl   String? @map("image_url")
  videoUrl   String? @map("video_url")
  author     String?

  category  NewsCategory
  mediaKind NewsMediaKind @map("media_kind")

  publishedAt DateTime @map("published_at")

  viewsCount Int @default(0) @map("views_count")
  savesCount Int @default(0) @map("saves_count")

  createdAt DateTime @default(now()) @map("created_at")

  savedBy SavedNewsItem[]

  @@unique([sourceId, externalId])
  @@index([publishedAt])
  @@index([category, publishedAt])
  @@map("news_items")
}

/// A "salvar para depois" bookmark. The unique pair is what makes the
/// save/unsave routes idempotent — POSTing twice can't double-count.
model SavedNewsItem {
  id     String @id @default(uuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  newsItemId String   @map("news_item_id")
  newsItem   NewsItem @relation(fields: [newsItemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, newsItemId])
  @@index([userId, createdAt])
  @@map("saved_news_items")
}

/// Every Stripe event id we have already processed.
///
/// Stripe retries aggressively and replays are normal, not exceptional. Some
/// handlers guarded themselves and some did not — a replayed `invoice.paid`
/// for a maintenance agreement wrote a second revenue row, incremented the
/// wallet again and fired another real Transfer. Recording the event id once,
/// at the top of the dispatcher, closes every one of those holes in a single
/// place instead of relying on each handler to remember.
///
/// The primary key IS the Stripe event id, so a concurrent duplicate loses the
/// insert with P2002 rather than racing past a read-then-write check.
model ProcessedStripeEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now()) @map("processed_at")

  @@index([processedAt])
  @@map("processed_stripe_events")
}
