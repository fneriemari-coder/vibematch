{
  "compilerOptions": {
    "module": "commonjs",
    // Without an explicit rootDir, tsc infers the common root of every
    // included file. prisma/seed.ts sits outside src/, so that root became
    // the project dir and the emit was mirrored as dist/src/main.js — while
    // package.json's start:prod and the Docker CMD both expect dist/main.js.
    "rootDir": "./src",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "paths": {
      "@common/*": ["src/common/*"],
      "@modules/*": ["src/modules/*"]
    }
  },
  // Scoped to src/ so rootDir above holds. The prisma/*.ts scripts are
  // intentionally out — they compile to dist-seed/ through their own
  // `build:seed*` commands, not through this project. Because that leaves
  // them unchecked here, tsconfig.seed.json typechecks them separately and
  // CI runs it (`npm run typecheck:seeds`) right after this one.
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
